def read_invoice_line(raw_line):
    parts = raw_line.strip().split("@")
    left = parts[0].rstrip()
    unit_price = float(parts[1].strip())
    fields = left.split("x")
    item_name = fields[0].strip()
    quantity = int(fields[1].strip())
    return {"item": item_name, "qty": quantity, "unit_price": unit_price}

def total_for_lines(raw_lines):
    grand_total = 0.0
    for raw_line in raw_lines:
        parsed = read_invoice_line(raw_line)
        grand_total += parsed["qty"] * parsed["unit_price"]
    return round(grand_total, 2)

def vat_gross(net_amount, vat_rate):
    gross_amount = net_amount * (1.0 + vat_rate)
    return round(gross_amount, 2)

def cac_payback_months(cac_eur, monthly_gross_profit):
    months_needed = cac_eur / monthly_gross_profit
    whole_months = int(months_needed)
    if months_needed > whole_months:
        whole_months += 1
    return whole_months

def churn_projection(start_customers, monthly_churn, month_count):
    remaining = float(start_customers)
    for _ in range(month_count):
        remaining = remaining * (1.0 - monthly_churn)
    return int(round(remaining))

