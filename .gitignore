# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv/
.venv-gemma/
venv/

# Rust build artifacts
cmcore/target/
**/*.rs.bk

# Downloaded / generated corpora (reproducible via data/fetch_data.py)
data/corpora/

# OS cruft
Thumbs.db
.DS_Store

# Keep results/ (results.json, pareto.png, champion.json) committed as run evidence.

# LLM weight dataset (downloaded models + packed binaries; regenerable) —
# but KEEP result logs, figures, and notes: they are the paper's run evidence.
weights/data/*
!weights/data/*.log
!weights/data/*.txt
!weights/data/*.md
!weights/data/*.png
# figures are run evidence too; the three older charts had to be force-added because this
# exception was missing. NOTE: .gitignore has no trailing comments - a comment on the
# pattern line makes it part of the pattern, which is exactly how this was broken twice.
!weights/data/*.svg
!weights/data/*.json

# third-party llama.cpp binaries (re-downloadable, ~1.8GB)
tools/llamacpp/
tools/llama.cpp-src/
# portable build toolchain (approved download, re-fetchable)
tools/w64devkit/
tools/w64devkit.pkg
tools/cmake-*/
tools/cmake.zip
tools/llama.cpp-src/build*/

# python build artifacts
build/
dist/
*.egg-info/
weights/data/community_etas.json
quantize_proof.log
# session-noise patterns (uncurated harness output) - the evidence-log manifest stays auto-tracked
weights/data/crux*.log
weights/data/gen_*.log
weights/data/revalidation_*.log
weights/data/quantize_proof.log

# llama.cpp builds live outside the repo - never commit binaries
tools/*
# ...except our own source. kernelprobe is a standalone CUDA benchmark with no llama.cpp in it.
# (git will not descend into an excluded directory, so exclude the CONTENTS and re-admit ours.)
!tools/kernelprobe/
tools/kernelprobe/*
!tools/kernelprobe/*.cu
!tools/kernelprobe/*.py
# transient plumbing: gate runs, release builds, per-arm server logs
weights/data/*_gate_*.log
weights/data/release_*.log
weights/data/*_server.log

!weights/data/phaseb_corpus*.jsonl
# KR-E1 of prereg 2026-08-06 stakes that EV-1 result JSONs are COMMITTED RAW. The
# weights/data/* rule above excludes them, because its exceptions only match files
# directly in weights/data and these live several directories down. 17 files, 0.1 MB.
!weights/data/ev1/
weights/data/ev1/**
!weights/data/ev1/**/
!weights/data/ev1/**/results_*.json
